# Clés Stripe (https://dashboard.stripe.com/apikeys). Sans elles, la boutique reste en mode démonstration.
STRIPE_SECRET_KEY=sk_test_...
# Secret du webhook (stripe listen --forward-to localhost:8787/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...
# Adresse publique du site, utilisée pour les retours depuis Stripe
PUBLIC_URL=http://localhost:5173
PORT=8787
